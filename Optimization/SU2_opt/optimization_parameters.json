{
    "problem_data": {
        "parallel_type": "OpenMP",
        "echo_level": 0
    },
    "analyses": [
        {
            "name": "SU2",
            "type": "remote_analysis_execution_policy",
            "settings": {
                "model_part_names": [
                    "WING"
                ],
                "io_settings": {
                    "type": "kratos_co_sim_io",
                    "echo_level": 4,
                    "my_name": "Kratos_opt",
                    "connect_to": "run_SU2",
                    "communication_format": "file"
                }
            }
        }
    ],
    "responses": [
        {
            "name": "efficiency",
            "type": "remote_response_function",
            "settings": {
                "evaluated_model_part_names": [
                    "WING"
                ],
                "primal_analysis_name": "SU2"
            }
        }
    ],
    "controls": [
        {
            "name": "shape_control",
            "type": "shape.vertex_morphing_shape_control",
            "settings": {
                "controlled_model_part_names": [
                    "WING"
                ],
                "output_all_fields": true,
                "filter_settings": {
                    "filter_type": "explicit_filter",
                    "filter_function_type": "cosine",
                    "max_nodes_in_filter_radius": 100000,
                    "filter_radius_settings": {
                        "filter_radius_type": "constant",
                        "filter_radius": 0.2
                    },
                    "filtering_boundary_conditions": {
                        "damping_type": "nearest_entity",
                        "damping_function_type": "cosine",
                        "damped_model_part_settings": {}
                    }
                }
            }
        }
    ],
    "algorithm_settings": {
        "type": "algorithm_steepest_descent",
        "settings": {
            "echo_level": 0,
            "line_search": {
                "type": "const_step",
                "init_step": 1e-3,
                "gradient_scaling": "l2_norm"
            },
            "conv_settings": {
                "type": "max_iter",
                "max_iter": 1
            }
        },
        "controls": [
            "shape_control"
        ],
        "objective": {
            "response_name": "efficiency",
            "type": "minimization",
            "scaling": 1.0
        }
    },
    "processes": {
        "kratos_processes": {},
        "optimization_data_processes": {
            "output_processes": [
                {
                    "type": "optimization_problem_ascii_output_process",
                    "module": "KratosMultiphysics.OptimizationApplication.processes",
                    "settings": {
                        "output_file_name": "summary.csv",
                        "write_kratos_version": false,
                        "write_time_stamp": false
                    }
                },
                {
                    "type": "optimization_problem_vtu_output_process",
                    "module": "KratosMultiphysics.OptimizationApplication.processes",
                    "settings": {
                        "file_name": "wing_<step>",
                        "file_format": "binary",
                        "output_path": "Optimization_Results",
                        "save_output_files_in_folder": true,
                        "write_deformed_configuration": false,
                        "list_of_output_components": [
                            "all"
                        ],
                        "output_precision": 7,
                        "output_interval": 1,
                        "echo_level": 0
                    }
                }
            ]
        }
    }
}